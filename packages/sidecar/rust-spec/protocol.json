{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AntigravitySidecarProtocol",
  "description": "WebSocket / IPC Protocol specification for Antigravity live recording and sidecar daemons (Rust / Go / Swift / Node)",
  "definitions": {
    "TracerMessage": {
      "type": "object",
      "required": ["type", "timestamp"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "EVENT_CLICK",
            "EVENT_INPUT",
            "EVENT_SUBMIT",
            "EVENT_NAVIGATE",
            "HOTKEY_PAUSE",
            "HOTKEY_RESUME",
            "HOTKEY_COMMENT",
            "HOTKEY_DEBUG",
            "STATE_TRANSITION",
            "SESSION_START",
            "SESSION_STOP",
            "OVERLAY_PIN_UPDATE"
          ]
        },
        "sessionId": { "type": "string" },
        "step": { "type": "integer" },
        "timestamp": { "type": "integer" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "comment": { "type": "string" },
        "target": {
          "type": "object",
          "properties": {
            "tagName": { "type": "string" },
            "selector": { "type": "string" },
            "componentName": { "type": "string" },
            "filePath": { "type": "string" },
            "lineNumber": { "type": "integer" },
            "handlerName": { "type": "string" }
          }
        }
      }
    }
  }
}
